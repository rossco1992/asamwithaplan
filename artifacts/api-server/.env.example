# Copy to .env and fill in. Loaded by `pnpm --filter api-server dev:local`.

# Port the server listens on.
# - Local dev: keep 3001 (matches API_PROXY_TARGET in the marrymap .env).
# - Single-server production: set this to your public port (e.g. 8080) — the
#   same server also serves the built frontend.
PORT=3001

# Postgres connection string. Any local Postgres works, e.g.
#   docker run --name marrymap-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=marrymap -p 5432:5432 -d postgres:16
# Then apply the schema with: pnpm --filter db push
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marrymap

# OpenAI API key — create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# Optional: only set to target a proxy / OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Clerk keys (Clerk Dashboard -> API Keys). A pk_test_/sk_test_ development
# pair works on localhost with no extra config.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: absolute path to the built frontend (artifacts/marrymap/dist/public).
# Leave unset to use the default monorepo location in single-server production.
# STATIC_DIR=/app/artifacts/marrymap/dist/public
