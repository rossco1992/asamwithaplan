# Copy to .env and fill in. Loaded by `pnpm --filter api-server dev:local`.

# Port the Express API listens on. Must match API_PROXY_TARGET in the
# marrymap frontend .env (default there is http://localhost:3001).
PORT=3001

# Postgres connection string. Any local Postgres works, e.g.
#   createdb marrymap
# Then apply the schema with: pnpm --filter db push
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marrymap

# OpenAI: point the base URL at the real API and use your own key.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key

# Clerk development instance keys (Clerk Dashboard → API Keys).
# The pk_test_/sk_test_ pair works directly in dev — no proxy needed.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
