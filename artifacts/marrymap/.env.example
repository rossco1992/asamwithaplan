# Copy to .env. Read by vite.config.ts (via loadEnv) for local dev.

# Port the vite dev server listens on. This is the URL you open in the browser.
PORT=5173

# App base path. Use "/" for local dev (Replit sets this to a sub-path in prod).
BASE_PATH=/

# Where vite forwards /api requests. Must match the api-server PORT.
API_PROXY_TARGET=http://localhost:3001

# Clerk publishable key (same value as CLERK_PUBLISHABLE_KEY in the api-server
# .env). Exposed to the browser, so only ever use the publishable (pk_) key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
